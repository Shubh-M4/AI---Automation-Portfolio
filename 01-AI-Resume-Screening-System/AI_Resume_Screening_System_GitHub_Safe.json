    {
      "parameters": {
        "jsCode": "// 1. Get matching rows from Google Sheets\nconst matches = $input.all();\n\n// 2. Get current candidate from Loop Over Items\nconst candidate = $(\"Loop Over Items\").item.json;\n\n// 3. Normalize current candidate email\nconst email = (candidate[\"Email Address\"] || \"\")\n  .trim()\n  .toLowerCase();\n\n// 4. Count matching email records\nconst duplicateCount = matches.filter(item => {\n  const sheetEmail = (item.json[\"Email Address\"] || \"\")\n    .trim()\n    .toLowerCase();\n\n  return sheetEmail === email;\n}).length;\n\n// 5. Preserve candidate data and add duplicate status\nreturn [{\n  json: {\n    ...candidate,\n    duplicate_count: duplicateCount,\n    is_duplicate: duplicateCount > 1\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "59f52d02-efcd-4e1a-8fa8-ecbf968721c1",
      "name": "Code in JavaScript"
    },
